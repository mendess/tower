server {
    server_name audiobookshelf.mendess.xyz;
    listen 443 ssl;
    http2 on;

    access_log /var/log/nginx/audiobookshelf.access.log;
    error_log /var/log/nginx/audiobookshelf.error.log;

    include /etc/nginx/shared-conf/private-service.conf;
    include /etc/nginx/shared-conf/ssl.conf;

    location / {
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
        proxy_set_header Host               $http_host;
        proxy_set_header Upgrade            $http_upgrade;
        proxy_set_header Connection         "upgrade";

        proxy_http_version                  1.1;

        proxy_pass                          http://127.0.0.1:13378;

        # Prevent 413 Request Entity Too Large error
        # by increasing the maximum allowed size of the client request body
        # For example, set it to 10 GiB
        client_max_body_size                10240M;
   }
}

server {
    if ($host = audiobookshelf.mendess.xyz) {
        return 301 https://$host$request_uri;
    }

    server_name audiobookshelf.mendess.xyz;
    listen 80;
    return 404;
}

server {
    if ($host = audiobookshelf.pendrellvale.home) {
        return 301 https://audiobookshelf.mendess.xyz$request_uri;
    }

    server_name audiobookshelf.pendrellvale.home;
    listen 80;
    return 404;
}
