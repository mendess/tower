server {
    include /etc/nginx/shared-conf/listen.conf;
    server_name ntfy.mendess.xyz;

    include /etc/nginx/shared-conf/private-service.conf;

    include /etc/nginx/shared-conf/ssl.conf;

    location / {
        include /etc/nginx/shared-conf/base.conf;
        proxy_pass http://127.0.0.1:5666;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_connect_timeout 3m;
        proxy_send_timeout 3m;
        proxy_read_timeout 3m;

        client_max_body_size 0; # Stream request body to backend
    }
}

server {
    server_name ntfy.mendess.xyz;
    include /etc/nginx/shared-conf/http-redirect.conf;
    include /etc/nginx/shared-conf/private-service.conf;
}
