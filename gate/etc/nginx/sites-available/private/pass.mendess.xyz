server {
    server_name pass.mendess.xyz;
    include /etc/nginx/shared-conf/listen.conf;
    client_max_body_size 50M;

    include /etc/nginx/shared-conf/base.conf;
    include /etc/nginx/shared-conf/ssl.conf;
    include /etc/nginx/shared-conf/private-service.conf;

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin "https://home.mendess.xyz" always;
        proxy_pass http://127.0.0.1:6056;
    }
}
server {
    server_name pass.mendess.xyz;
    listen 80;
    return 301 https://$host$request_uri;
}
