server {
    server_name navidrome.mendess.xyz;
    listen 443 ssl;

    client_max_body_size 50M;
    large_client_header_buffers 4 32k;

    include /etc/nginx/shared-conf/private-service.conf;
    include /etc/nginx/shared-conf/ssl.conf;

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin "*" always;

        proxy_pass http://127.0.0.1:4533;
    }
}
server {
    server_name navidrome.mendess.xyz, navidrome.pendrellvale.home;
    listen 80;
    return 301 https://navidrome.mendess.xyz$request_uri;
}
