server {
    server_name jellyfin.mendess.xyz;
    listen 443 ssl;
    http2 on;

    # allow large file uploads
    client_max_body_size 20M;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Protocol $scheme;
    proxy_set_header X-Forwarded-Host $http_host;

    include /etc/nginx/shared-conf/base.conf;
    include /etc/nginx/shared-conf/private-service.conf;
    include /etc/nginx/shared-conf/ssl.conf;

    location / {
        proxy_pass http://127.0.0.1:8096;
        # Disable buffering when the nginx proxy gets very resource heavy upon streaming
        proxy_buffering off;
    }

    # Proxy Jellyfin Websockets traffic
    location /socket {
        proxy_pass http://127.0.0.1:8096;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # enable websockets: http://nginx.org/en/docs/http/websocket.html
        proxy_redirect     off;
    }
}

server {
    server_name jellyfin.pendrellvale.home;
    server_name jellyfin.mendess.xyz;
    listen 80;
    http2 on;

    return 301 https://jellyfin.mendess.xyz$request_uri;
}
